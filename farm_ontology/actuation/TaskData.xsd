<?xml version="1.0" encoding="UTF-8"?>
<!--
  TaskData.xsd — farm-ontology TaskData profile schema (WS5.1 fixture).

  IMPORTANT HONESTY NOTE: this schema is generated by farm-ontology for its
  own ISO 11783-10 TaskSet *shape contract*. It is the single source of truth
  for the exporter in taskset_export.py (packaged into every ZIP) and for the
  offline structural validator. It is NOT the accredited ISO 11783-10 XSD —
  stdlib Python cannot validate against a real XSD anyway, and obtaining the
  normative document is a licensed-text task. Controller-level conformance is
  validation backlog pinned to the Phase-4 field drill (gate.field_drill_completed).
-->
<xsd:schema xmlns:xsd="http://www.w3.org/2001/XMLSchema">

  <xsd:annotation>
    <xsd:documentation>Profile: farm-ontology seed v1.0. Root element
      Iso11783TaskData carries the mandatory software/version attrs; a
      Partfield carries a closed Polygon of Points (WGS84 decimal degrees,
      PointNorth=latitude, PointEast=longitude) plus optional TreatmentZones
      (table prescriptions); a Task may carry one GridInfo whose reference
      names a grid companion file in the TaskSet ZIP.</xsd:documentation>
  </xsd:annotation>

  <xsd:element name="Iso11783TaskData" type="Iso11783TaskDataType"/>

  <xsd:complexType name="Iso11783TaskDataType">
    <xsd:sequence>
      <xsd:element name="Customer" type="CustomerType" minOccurs="0" maxOccurs="1"/>
      <xsd:element name="Farm" type="FarmType" minOccurs="0" maxOccurs="1"/>
      <xsd:element name="Partfield" type="PartfieldType" minOccurs="1" maxOccurs="unbounded"/>
      <xsd:element name="Task" type="TaskType" minOccurs="1" maxOccurs="unbounded"/>
    </xsd:sequence>
    <xsd:attribute name="VersionMajor" type="xsd:string" use="required"/>
    <xsd:attribute name="VersionMinor" type="xsd:string" use="required"/>
    <xsd:attribute name="DataTransferOrigin" type="xsd:string" use="required"/>
    <xsd:attribute name="ManagementSoftwareManufacturer" type="xsd:string" use="required"/>
    <xsd:attribute name="ManagementSoftwareVersion" type="xsd:string" use="required"/>
    <xsd:attribute name="TransferFileLanguage" type="xsd:string" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="CustomerType">
    <xsd:attribute name="CustomerId" type="xsd:string" use="required"/>
    <xsd:attribute name="LastName" type="xsd:string" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="FarmType">
    <xsd:attribute name="FarmId" type="xsd:string" use="required"/>
    <xsd:attribute name="FarmDesignator" type="xsd:string" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="PartfieldType">
    <xsd:sequence>
      <xsd:element name="Polygon" type="PolygonType" minOccurs="1" maxOccurs="1"/>
      <xsd:element name="TreatmentZone" type="TreatmentZoneType" minOccurs="0" maxOccurs="unbounded"/>
    </xsd:sequence>
    <xsd:attribute name="PartfieldId" type="xsd:string" use="required"/>
    <xsd:attribute name="PartfieldDesignator" type="xsd:string" use="required"/>
    <xsd:attribute name="PartfieldArea" type="xsd:string" use="optional"/>
  </xsd:complexType>

  <xsd:complexType name="PolygonType">
    <xsd:sequence>
      <xsd:element name="Point" type="PointType" minOccurs="3" maxOccurs="unbounded"/>
    </xsd:sequence>
    <xsd:attribute name="PolygonType" type="xsd:string" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="PointType">
    <xsd:attribute name="PointNorth" type="xsd:string" use="required"/>
    <xsd:attribute name="PointEast" type="xsd:string" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="TreatmentZoneType">
    <xsd:sequence>
      <xsd:element name="Attr" type="AttrType" minOccurs="1" maxOccurs="unbounded"/>
    </xsd:sequence>
    <xsd:attribute name="TreatmentZoneCode" type="xsd:string" use="required"/>
    <xsd:attribute name="TreatmentZoneDesignator" type="xsd:string" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="AttrType">
    <xsd:attribute name="AttName" type="xsd:string" use="required"/>
    <xsd:attribute name="AttValue" type="xsd:string" use="required"/>
    <xsd:attribute name="Unit" type="xsd:string" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="TaskType">
    <xsd:sequence>
      <xsd:element name="GridInfo" type="GridInfoType" minOccurs="0" maxOccurs="1"/>
    </xsd:sequence>
    <xsd:attribute name="TaskId" type="xsd:string" use="required"/>
    <xsd:attribute name="TaskDesignator" type="xsd:string" use="required"/>
    <xsd:attribute name="TaskStatus" type="xsd:string" use="required"/>
    <xsd:attribute name="TaskTreatmentProcessCode" type="xsd:string" use="required"/>
    <xsd:attribute name="TaskPartfieldIdRef" type="xsd:string" use="required"/>
    <xsd:attribute name="DefaultQuantityValuesFlag" type="xsd:string" use="required"/>
    <xsd:attribute name="UseClass" type="xsd:string" use="required"/>
  </xsd:complexType>

  <xsd:complexType name="GridInfoType">
    <xsd:attribute name="GridFileReference" type="xsd:string" use="required"/>
    <xsd:attribute name="GridMinNorth" type="xsd:string" use="required"/>
    <xsd:attribute name="GridMinEast" type="xsd:string" use="required"/>
    <xsd:attribute name="GridCellWidth" type="xsd:string" use="required"/>
    <xsd:attribute name="GridCellHeight" type="xsd:string" use="required"/>
    <xsd:attribute name="GridRowCount" type="xsd:string" use="required"/>
    <xsd:attribute name="GridColumnCount" type="xsd:string" use="required"/>
    <xsd:attribute name="MaximumTreatmentZoneCode" type="xsd:string" use="required"/>
    <xsd:attribute name="MinimumTreatmentZoneCode" type="xsd:string" use="required"/>
  </xsd:complexType>

</xsd:schema>
